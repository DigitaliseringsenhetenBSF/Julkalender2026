{
  "name": "miljojulkalendern",
  "version": "0.1.0",
  "private": true,
  "description": "Miljöjulkalendern – environmental Advent calendar for Skolkontoret, BSF, Lunds kommun",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "dev:api": "node --env-file-if-exists=.env --watch src/api/main.ts",
    "dev:web": "vite",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:seed:demo": "node --env-file-if-exists=.env scripts/seed.ts --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist/src/api/main.js",
    "smoke": "node scripts/smoke.ts",
    "gdpr:purge": "node --env-file-if-exists=.env scripts/gdpr-purge.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
