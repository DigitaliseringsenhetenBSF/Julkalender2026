# Copy to .env for local development. Never commit real values.

# development | test | staging | production
APP_ENV=development

# HTTP port for the API server (Render sets PORT automatically).
PORT=3001

# PostgreSQL connection string. Required in staging/production.
# Leave empty locally to use the embedded PGlite database in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Secret used to sign the session cookie. Required (32+ chars) in staging/production.
SESSION_SECRET=

# Identity provider (SPEC §8):
#   dev     the test-user picker; refused when APP_ENV=production
#   portal  Verktygsportalen's login: the portal proxies the calendar under BASE_PATH and vouches
#           for the signed-in person in headers signed by PORTAL_KEY (the only mode in production)
AUTH_MODE=dev

# Portal mode only. The same value as JULKALENDER_KEY on the portal's web service, 32+ chars
# (openssl rand -hex 32). Required whenever AUTH_MODE=portal, locally too.
PORTAL_KEY=

# The path the app is served under, e.g. /julkalender behind the portal. Read by the server at
# start and by `npm run build` (Vite's base), so set it before building. Empty = the root.
BASE_PATH=

# Date simulation for development/staging only. Refused when APP_ENV=production.
# Either a date (YYYY-MM-DD) or a full ISO timestamp, e.g. 2026-11-30T23:59:00+01:00
FAKE_TODAY=
